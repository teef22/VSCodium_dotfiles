// vscodium v1.126.04524

[
    // // ### Keyboard Rule

    // {
    //     "key": "",                   // define shortcut (i.e. "ctrl+f") or chord (i.e. "ctrl+m alt+right")
    //     "command": "",               // one command to execute or "runCommands" with multiple commands specified as array "commands": [...] in "args"
    //                                  // it is possible to specify empty "" command
    //
    //     "args": {},                  // comma-separated collection of arguments used alongside invoked command
    //     "args": {
    //         "commands": [
    //             {
    //                 "command": "...",
    //                 "args": {},
    //             },
    //             {
    //                 "command": "...",
    //                 "args": {},
    //             }
    //         ]
    //     },                           // in case of "runCommands", "args" has only one attribute "commands", which is an array of {"command": , "args": } pairs
    //                                  // "args" of "command" can be either {key: value, ...} or [value, value, ...]
    //                                  // it is possible to specify empty "" command
    //
    //     "when": "",                  // context-based boolean expression (optional)
    //     "systemWide": [true|false],  // wether to process systemwide (when VSCodium is not focused; usually not needed)
    // }

    {
        "key": "shift+alt+l",
        "command": "-bookmarks.expandSelectionToNext",
        "when": "editorTextFocus"
    },
    {
        "key": "shift+alt+j",
        "command": "-bookmarks.expandSelectionToPrevious",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+alt+l",
        "command": "-bookmarks.jumpToNext",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+alt+j",
        "command": "-bookmarks.jumpToPrevious",
        "when": "editorTextFocus"
    },
    {
        "key": "shift+alt+k",
        "command": "-bookmarks.shrinkSelection",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+alt+k",
        "command": "-bookmarks.toggle",
        "when": "editorTextFocus"
    },

    // // ### Vim's Keyboard Rule

