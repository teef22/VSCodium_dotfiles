    // (Recursive)

    "vim.insertModeKeyBindings": [
        // jump exit
        {
            "before": ["j", "j"],
            "after": ["<Esc>"]
        },
    ],
    "vim.normalModeKeyBindings": [
        // save file
        {
            "before": ["leader", "w"],
            "commands": [
                "workbench.action.files.save",
            ]
        },
        // hide search highlighting
        {
            "before":["<C-n>"],
            "commands": [
                ":nohl",
            ]
        },
        // bookmarking stuff
        {
            "before": ["<leader>", "m", "m"],
            "commands": [
                "bookmarks.toggle"
            ]
        },
        {
            "before": ["<leader>", "m", "l"],
            "commands": [
                "bookmarks.toggleLabeled"
            ]
        },
        {
            "before": ["<leader>", "m", "j"],
            "commands": [
                "bookmarks.jumpToNext"
            ]
        },
        {
            "before": ["<leader>", "m", "k"],
            "commands": [
                "bookmarks.jumpToPrevious"
            ]
        },
        {
            "before": ["<leader>", "<S-m>"],
            "commands": [
                "bookmarks.listFromAllFiles"
            ]
        },
        // disable vim's bookmarking
        {
            "before": ["m"],
            "after": []
        }
    ],
    "vim.visualModeKeyBindings": [
        // continuous indentation mode with </>
        {
            "before": [">"],
            "commands": [
                "editor.action.indentLines"
            ]
        },
        {
            "before": ["<"],
            "commands": [
                "editor.action.outdentLines"
            ]
        },
    ],
    "vim.operatorPendingModeKeyBindings": [
        // duplicate w/e motions on {/} keys
        {
            "before": ["{"],
            "after": ["w"]
        },
        {
            "before": ["}"],
            "after": ["e"]
        },
        // duplicate ^/$ motions on L/H keys
        {
            "before": ["<S-l>"],
            "after": ["$"]
        },
        {
            "before": ["<S-h>"],
            "after": ["^"]
        },
    ],

    // (Non Recursive)

    "vim.normalModeKeyBindingsNonRecursive": [
        // do not override register on "x" in normal mode
        {
            "before": ["x"],
            "after": ["\"", "_", "x"]
        },
        {
            "before": ["<S-x>"],
            "after": ["\"", "_", "<S-x>"]
        },
        // do not override register on "s" in normal mode
        {
            "before": ["s"],
            "after": ["\"", "_", "s"]
        },
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        // do not override register on "p" in visual mode
        {
            "before": ["p"],
            "after": ["p", "g", "v", "y"]
        },
        // do not override register on "x" in visual mode
        {
            "before": ["x"],
            "after": ["\"", "_", "x"]
        },
        {
            "before": ["<S-x>"],
            "after": ["\"", "_", "<S-x>"]
        },
        // do not override register on "s" in visual mode
        {
            "before": ["s"],
            "after": ["\"", "_", "s"]
        },
    ],
