{
    // -------------------------------------------------------------------------
    // ### Text Editor
    "editor.accessibilitySupport": "off",
    "editor.renderLineHighlight": "all",
    "editor.rulers": [
        80, 100, 120
    ],
    "editor.scrollBeyondLastColumn": 5,
    "editor.selectionHighlightMultiline": true,
    "editor.showFoldingControls": "always",
    "editor.trimWhitespaceOnDelete": true,

    // Text Editor -> Cursor
    "editor.cursorBlinking": "solid",
    "editor.cursorStyle": "block",

    // Text Editor -> Find

    // Text Editor -> Font
    "editor.fontFamily": "AdwaitaMono Nerd Font Mono",
    "editor.fontLigatures": true,
    "editor.fontVariations": true,

    // Text Editor -> Formatting
    "editor.formatOnPaste": true,

    // Text Editor -> Diff Editor

    // Text Editor -> Minimap
    "editor.minimap.enabled": false,

    // Text Editor -> Suggestions
    "editor.suggest.matchOnWordStartOnly": false,
    "editor.suggest.preview": true,
    // // whether to show hints at the bottom of suggestions window
    // "editor.suggest.showStatusBar": true,

    // Text Editor -> Files
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,

    // -------------------------------------------------------------------------
    // ### Workbench
    "workbench.layoutControl.enabled": false,
    "workbench.localHistory.maxFileEntries": 100,
    "workbench.navigationControl.enabled": false,
    "workbench.panel.showLabels": false,
    "workbench.productIconTheme": "fluent-icons",
    "workbench.reduceTransparency": "auto",
    "workbench.remoteIndicator.showExtensionRecommendations": false,
    "workbench.sash.size": 10,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.shadows": false,
    "workbench.commandPalette.showAskInChat": false,
    "workbench.statusBar.experimental.fontFamily": "AdwaitaMono Nerd Font Mono",
    "workbench.statusBar.experimental.fontSize": 14,
    "workbench.tabs.experimental.fontFamily": "AdwaitaMono Nerd Font Mono",
    "workbench.tabs.experimental.fontSize": 14,

    // Workbench -> Appearance
    "workbench.activityBar.compact": true,
    "workbench.colorTheme": "Rosé Pine",
    "workbench.iconTheme": "ayu",
    "workbench.preferredDarkColorTheme": "Rosé Pine",
    "workbench.preferredLightColorTheme": "Rosé Pine Dawn",
    "workbench.sideBar.location": "right",
    // // open directories on double click
    // "workbench.tree.expandMode": "doubleClick",
    "workbench.tree.indent": 14,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.tree.stickyScrollMaxItemCount": 10,
    "workbench.view.alwaysShowHeaderActions": true,

    // Workbench -> Breadcrumbs

    // Workbench -> Editor Management
    "workbench.editor.doubleClickTabToToggleEditorGroupSizes": "maximize",
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "workbench.editor.sharedViewState": true,
    "workbench.editor.showTabIndex": true,
    "workbench.editor.tabActionCloseVisibility": false,
    "workbench.editor.titleScrollbarVisibility": "hidden",
    "workbench.editor.useModal": "off",

    // Workbench -> Settings Editor
    "workbench.settings.alwaysShowAdvancedSettings": true,
    "workbench.settings.openDefaultKeybindings": true,
    "workbench.settings.openDefaultSettings": true,

    // Workbench -> Zen Mode
    "zenMode.hideLineNumbers": false,
    "zenMode.hideStatusBar": false,

    // Workbench -> Screencast Mode

    // Workbench -> Browser
    "workbench.browser.searchEngine": "duckduckgo",
    "workbench.browser.showInTitleBar": false,
    "workbench.browser.enableChatTools": false,

    // -------------------------------------------------------------------------
    // ### Window
    "window.autoDetectHighContrast": false,
    "window.dialogStyle": "custom",
    "window.enableMenuBarMnemonics": false,
    "window.menuBarVisibility": "compact",
    // // each int value equals to +20% scale
    // // minus means -xxx%
    // "window.zoomLevel": 1,

    // Window -> New Window

    // -------------------------------------------------------------------------
    // ### Chat

    // Chat -> Agent
    "chat.agent.enabled": false,
    // // allow chat access to network via black / white lists
    // "chat.agent.networkFilter": true,
    "chat.checkpoints.showFileChanges": true,

    // Chat -> Appearance

    // Chat -> Sessions
    "chat.viewProgressBadge.enabled": true,

    // Chat -> Tools

    // Chat -> MCP

    // Chat -> Context

    // Chat -> Inline Chat

    // Chat -> Miscellaneous

    // -------------------------------------------------------------------------
    // ### Features

    // Features -> Accessibility Signals

    // Features -> Accessibility
    // // visually enhance perception of the unfocused editor by dimming it
    // "accessibility.dimUnfocused.enabled": true,
    // // opacity of the unfocused editor
    // "accessibility.dimUnfocused.opacity": 0.8,
    "accessibility.underlineLinks": true,

    // Features -> Explorer
    "explorer.incrementalNaming": "smart",

    // Feature -> Search
    "search.defaultViewMode": "tree",
    "search.seedOnFocus": true,
    "search.showLineNumbers": true,
    "search.smartCase": true,
    "search.searchView.keywordSuggestions": true,

    // Features -> Debug
    "debug.breakpointsView.presentation": "tree",
    "debug.showVariableTypes": true,

    // Features -> Testing
    "testing.saveBeforeTest": false,

    // Features -> Source Control
    "scm.alwaysShowRepositories": true,
    "scm.compactFolders": false,
    "scm.countBadge": "focused",
    "scm.defaultViewMode": "tree",
    "scm.diffDecorationsGutterPattern": {
        "added": true
    },
    "scm.repositories.visible": 0,

    // Features -> Extensions

    // Features -> Terminal
    "terminal.explorerKind": "both",
    "terminal.external.linuxExec": "ghostty",
    "terminal.integrated.confirmOnExit": "hasChildProcesses",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.initialHint": false,
    "terminal.integrated.minimumContrastRatio": 1,
    // // whether to send keyboard shortcut directly to shell
    // "terminal.integrated.sendKeybindingsToShell": true,
    "terminal.integrated.splitCwd": "workspaceRoot",
    "terminal.integrated.suggest.insertTrailingSpace": true,
    "terminal.integrated.suggest.quickSuggestions": {
        "commands": "on",
        "arguments": "on",
        "unknown": "on"
    },
    "terminal.integrated.suggest.showStatusBar": false,
    "terminal.integrated.suggest.upArrowNavigatesHistory": false,
    "terminal.integrated.tabs.focusMode": "singleClick",
    "terminal.integrated.tabs.hideCondition": "never",
    "terminal.integrated.tabs.showActions": "never",
    "terminal.integrated.tabs.showActiveTerminal": "never",
    "terminal.integrated.tabs.title": "${process}${separator}${cwd}",
    "terminal.sourceControlRepositoriesKind": "both",

    // Features -> Task
    "task.saveBeforeRun": "prompt",
    "task.verboseLogging": true,

    // Features -> Problems

    // Features -> Output

    // Features -> Comment

    // Features -> Remote

    // Features -> Timeline
    "timeline.pageSize": null,

    // Features -> Notebook
    "notebook.insertFinalNewline": true,
    "notebook.lineNumbers": "on",
    "notebook.outline.showCodeCells": true,

    // Features -> Merge Editor

    // -------------------------------------------------------------------------
    // ### Application

    // Application -> Proxy

    // Application -> Keyboard

    // Application -> Update

    // Application -> Telemetry
    "telemetry.feedback.enabled": false,

    // Application -> Network

    // Application -> Experimental

    // Applicaiton -> Other



}
