    "vim.operatorPendingModeKeyBindings": [
        // duplicate w/e motions on {/} keys
        {
            "before": ["{"],
            "after": ["w"]
        },
        {
            "before": ["}"],
            "after": ["e"]
        },
        // duplicate ^/$ motions on L/H keys
        {
            "before": ["<S-l>"],
            "after": ["$"]
        },
        {
            "before": ["<S-h>"],
            "after": ["^"]
        },
    ],

    // (Non Recursive)

    "vim.normalModeKeyBindingsNonRecursive": [
        // do not override register on "x" in normal mode
        {
            "before": ["x"],
            "after": ["\"", "_", "x"]
        },
        {
            "before": ["<S-x>"],
            "after": ["\"", "_", "<S-x>"]
        },
        // do not override register on "s" in normal mode
        {
            "before": ["s"],
            "after": ["\"", "_", "s"]
        },
        // disable sneak's default "s" in normal mode,
        // do not override register on "s" in normal mode
        {
            "before": ["s"],
            "after": ["\"", "_", "c", "l"]
        },
        // disable sneak's default "S" in normal mode,
        // do not override register on "s" in normal mode
        {
            "before": ["<S-s>"],
            "after": ["\"", "_", "c", "c"]
        },
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        // do not override register on "p" in visual mode
        {
            "before": ["p"],
            "after": ["p", "g", "v", "y"]
        },
        // do not override register on "x" in visual mode
        {
            "before": ["x"],
            "after": ["\"", "_", "x"]
        },
        // do not override register on "X" in visual mode
        {
            "before": ["<S-x>"],
            "after": ["\"", "_", "<S-x>"]
        },
        // disable sneak's default "s" in visual mode,
        // do not override register on "s" in visual mode
        {
            "before": ["s"],
            "after": ["\"", "_", "c"]
        },
    ],
}
